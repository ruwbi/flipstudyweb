# Copy this file to .env and fill in real values before running the server.
# Never commit your real .env file — it holds secrets.
# On Render, don't use a .env file at all — add these under your service's
# "Environment" tab instead, and redeploy after saving.

# Port the Express server listens on.
PORT=4000

# Allowed origin for CORS — the URL your frontend is served from.
# Local dev: http://localhost:5500 (or wherever you're serving the frontend).
# GitHub Pages: https://your-username.github.io
CLIENT_ORIGIN=http://localhost:5500

# Secret used to sign session tokens. Use any long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# ---------------------------------------------------------------------------
# EMAIL — pick ONE option below. If you set neither, the server runs in
# DEMO MODE: verification codes are returned directly in the API response
# and printed to the server console instead of being emailed, so the whole
# app (including forgot-password) still works with zero setup.
# ---------------------------------------------------------------------------

# OPTION A — Resend (recommended, especially on Render's free tier, which
# blocks the outbound SMTP ports Option B needs). Setup:
#   1. Sign up free at https://resend.com
#   2. Dashboard → API Keys → Create API Key → copy it (shown only once)
#   3. Paste it below as RESEND_API_KEY
#   4. EMAIL_FROM: until you verify your own domain in Resend, you must use
#      their shared test address below — using your own Gmail address here
#      will cause sends to fail. Once you verify a domain you own in Resend,
#      you can switch EMAIL_FROM to an address on that domain.
RESEND_API_KEY=
EMAIL_FROM="FlipStudy <onboarding@resend.dev>"

# OPTION B — Gmail via Nodemailer/SMTP. Only used if RESEND_API_KEY above is
# blank. Setup:
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an "App Password" (Google Account → Security → App Passwords).
#   3. Use that generated 16-character password below as EMAIL_PASS — your
#      normal Gmail password will NOT work here.
#   Note: many hosts (including Render's free tier) block the ports this
#   needs, so if emails silently don't arrive, try Option A instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
